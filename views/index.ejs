<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Q-Dev-AI Chatbot</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body>
    <a href="#messageInput" class="skip-to-content">Skip to content</a>

    <div id="appContainer" class="app-container">
      <div id="sidebarOverlay" class="sidebar-overlay"></div>
      <aside class="sidebar" aria-label="Sidebar">
        <div class="sidebar-header">
          <div id="sidebarLogo" class="brand"></div>
          <div class="sidebar-header-actions">
            <button id="sidebarSearchBtn" class="sidebar-icon-btn" title="Search chats (Ctrl+K)" aria-label="Search chats">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <circle cx="11" cy="11" r="7"></circle>
                <line x1="16.5" y1="16.5" x2="21" y2="21"></line>
              </svg>
            </button>
            <button id="sidebarToggle" class="sidebar-toggle" aria-label="Collapse sidebar">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="9" y1="3" x2="9" y2="21"></line>
              </svg>
            </button>
          </div>
        </div>

        <button id="newChatButton" class="new-chat-btn" aria-label="New chat">
          <span class="plus-icon" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 20h9"></path>
              <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L8 18l-4 1 1-4z"></path>
            </svg>
          </span>
          <span class="new-chat-label">New chat</span>
          <span class="new-chat-shortcut" aria-hidden="true">Ctrl N</span>
        </button>

        <div class="history-container">
          <div id="chatHistory" class="history-list"></div>
        </div>

        <div class="sidebar-footer">
          <profile-menu></profile-menu>
        </div>
      </aside>

      <main class="main-content">
        <div class="main-header">
          <button id="sidebarToggleMain" class="sidebar-toggle-main" aria-label="Open sidebar">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="3"></rect>
              <path d="M9 3v18"></path>
              <path d="m14 9 3 3-3 3"></path>
            </svg>
          </button>
          <button id="newChatButtonMain" class="new-chat-btn-main" aria-label="New chat">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 20h9"></path>
              <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L8 18l-4 1 1-4z"></path>
            </svg>
          </button>
          <button id="searchBtnMain" class="search-btn-main" title="Search chats (Ctrl+K)" aria-label="Search chats">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="7"></circle>
              <path d="m20 20-4-4"></path>
            </svg>
          </button>
        </div>

        <div id="welcomeScreen" class="welcome-screen">
          <div id="welcomeLogo" class="welcome-logo"></div>
          <h1 class="welcome-title">How can I help you?</h1>
        </div>

        <div id="chatArea" class="chat-area hidden">
          <header class="chat-header">
            <div class="chat-title-container">
              <span class="chat-title-mark" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z"></path>
                </svg>
              </span>
              <div class="chat-title-copy">
                <span class="chat-title-eyebrow">Conversation</span>
                <div class="chat-title-row">
                  <h2 id="currentChatTitle" class="chat-title">New Chat</h2>
                  <button id="editChatTitleBtn" class="edit-title-btn" title="Rename conversation" aria-label="Edit title">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 20h9"></path>
                      <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L8 18l-4 1 1-4z"></path>
                    </svg>
                  </button>
                </div>
              </div>
            </div>
            <div class="chat-header-actions">
              <button id="shareBtn" class="header-action-btn" title="Share chat" aria-label="Share chat">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 3v12"></path>
                  <path d="m7 8 5-5 5 5"></path>
                  <path d="M5 13v6a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6"></path>
                </svg>
                <span>Share</span>
              </button>
              <button id="exportPdfBtn" type="button" class="header-action-btn" title="Export as PDF" aria-label="Export as PDF">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                  <path d="M14 2v6h6"></path>
                  <path d="M12 11v6"></path>
                  <path d="m9 14 3 3 3-3"></path>
                </svg>
                <span>PDF</span>
              </button>
            </div>
          </header>

          <section id="messages" class="messages" role="log" aria-live="polite"></section>
          <div id="typingIndicator" class="thinking-indicator hidden" aria-label="AI is thinking" role="status">
            <div class="thinking-indicator-inner">
              <div class="thinking-avatar">
                <svg class="thinking-brain-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 2a7 7 0 0 0-7 7c0 2.38 1.19 4.47 3 5.74V17a2 2 0 0 0 2 2h4a2 2 0 0 0 2-2v-2.26c1.81-1.27 3-3.36 3-5.74a7 7 0 0 0-7-7z"/>
                  <line x1="9" y1="21" x2="15" y2="21"/>
                  <line x1="10" y1="14" x2="10" y2="17"/>
                  <line x1="14" y1="14" x2="14" y2="17"/>
                </svg>
                <div class="thinking-pulse-ring"></div>
              </div>
              <div class="thinking-content">
                <span id="thinkingStatusText" class="thinking-status-text">Thinking...</span>
                <div class="thinking-progress-bar">
                  <div class="thinking-progress-fill"></div>
                </div>
              </div>
              <div class="thinking-elapsed" id="thinkingElapsed"></div>
            </div>
          </div>
          <button id="scrollToBottomBtn" class="scroll-to-bottom-btn hidden" type="button" aria-label="Scroll to bottom" title="Scroll to bottom">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>
        </div>

        <div class="input-container">
          <button id="stopButton" class="stop-generation-btn hidden" type="button" aria-label="Stop generating">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
              <rect x="5" y="5" width="14" height="14" rx="2"/>
            </svg>
            <span>Stop generating</span>
          </button>
          <form id="chatForm" class="composer" autocomplete="off">
            <div class="input-wrapper">
              <div id="imagePreviewBar" class="image-preview-bar hidden">
                <div id="previewImagesList" class="preview-images-list"></div>
              </div>
              <textarea
                id="messageInput"
                placeholder="Message"
                maxlength="50000"
                rows="1"
                aria-label="Message input"
              ></textarea>
              <div id="recordingIndicator" class="recording-indicator hidden">
                <div class="recording-wave">
                  <span></span><span></span><span></span><span></span><span></span>
                </div>
                <span class="recording-text">Listening...</span>
                <span class="recording-tap-hint">Tap mic again to stop & send</span>
              </div>
              <div id="imageModeBanner" class="image-mode-banner hidden">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                  <circle cx="8.5" cy="8.5" r="1.5"></circle>
                  <polyline points="21 15 16 10 5 21"></polyline>
                </svg>
                <span>Image generation mode</span>
                <button id="exitImageModeBtn" type="button" class="exit-image-mode-btn">&times;</button>
              </div>
              <div class="input-footer">
                <div class="input-actions-left">
                  <div class="add-btn-wrapper">
                    <button id="addButton" type="button" class="add-btn" title="Add" aria-label="Add media">
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                      </svg>
                    </button>
                    <div id="addMenu" class="add-menu hidden">
                      <button class="add-menu-item" data-action="file">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"></path>
                        </svg>
                        <span>Add photos & files</span>
                      </button>
                      <button class="add-menu-item" data-action="audio">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M9 18V5l12-2v13"></path>
                          <circle cx="6" cy="18" r="3"></circle>
                          <circle cx="18" cy="16" r="3"></circle>
                        </svg>
                        <span>Upload audio</span>
                      </button>
                      <div class="add-menu-divider"></div>
                      <button class="add-menu-item" data-action="image-gen">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                          <circle cx="8.5" cy="8.5" r="1.5"></circle>
                          <polyline points="21 15 16 10 5 21"></polyline>
                        </svg>
                        <span>Create image</span>
                      </button>
                    </div>
                  </div>
                </div>
                <div class="input-actions-right">
                  <button id="attachButton" type="button" class="attach-btn" title="Attach file" aria-label="Attach file">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"></path>
                    </svg>
                  </button>
                  <input type="file" id="fileInput" accept="image/*,audio/*,video/*,application/pdf" multiple hidden />
                  <input type="file" id="imageInput" accept="image/*" multiple hidden />
                  <button id="audioAttachButton" type="button" class="attach-btn" title="Attach audio" aria-label="Attach audio">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M9 18V5l12-2v13"></path>
                      <circle cx="6" cy="18" r="3"></circle>
                      <circle cx="18" cy="16" r="3"></circle>
                    </svg>
                  </button>
                  <input type="file" id="audioInput" accept="audio/*" multiple hidden />
                  <button id="micButton" type="button" class="attach-btn mic-btn" title="Voice input" aria-label="Voice input">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"></path>
                      <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
                      <line x1="12" y1="19" x2="12" y2="23"></line>
                      <line x1="8" y1="23" x2="16" y2="23"></line>
                    </svg>
                  </button>
                  <button id="sendButton" type="submit" class="send-btn" disabled aria-label="Send message">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <line x1="12" y1="19" x2="12" y2="5"></line>
                      <polyline points="5 12 12 5 19 12"></polyline>
                    </svg>
                  </button>
                </div>
              </div>
            </div>
          </form>
          <p class="disclaimer">AI-generated, for reference only</p>
        </div>
      </main>
    </div>

    <!-- Canvas Panel -->
    <div id="canvasPanel" class="canvas-panel hidden">
      <div class="canvas-header">
        <span class="canvas-title">Canvas</span>
        <div class="canvas-actions">
          <button id="canvasCopyBtn" class="canvas-action-btn" aria-label="Copy code">Copy</button>
          <button id="canvasRunBtn" class="canvas-action-btn" aria-label="Run code">Run</button>
          <button id="canvasCloseBtn" class="canvas-action-btn canvas-close-btn" aria-label="Close canvas">&times;</button>
        </div>
      </div>
      <div class="canvas-body">
        <textarea id="canvasEditor" class="canvas-editor" spellcheck="false"></textarea>
        <iframe id="canvasPreview" class="canvas-preview" sandbox="allow-scripts"></iframe>
      </div>
    </div>

    <!-- Image Viewer -->
    <div id="imageViewer" class="image-viewer-overlay hidden" role="dialog" aria-label="Image viewer">
      <div class="image-viewer-content">
        <div class="image-viewer-header">
          <h3 id="imageViewerTitle">Generated Image</h3>
          <div class="image-viewer-actions">
            <button id="imageViewerCopy" class="image-viewer-action-btn" aria-label="Copy image">Copy</button>
            <button id="imageViewerDownload" class="image-viewer-action-btn" aria-label="Download image">Download</button>
            <button id="imageViewerEdit" class="image-viewer-action-btn" aria-label="Edit prompt">Edit</button>
            <button id="imageViewerClose" class="image-viewer-close-btn" aria-label="Close">&times;</button>
          </div>
        </div>
        <div class="image-viewer-body">
          <img id="imageViewerImg" src="" alt="Generated image" />
        </div>
        <div id="imageViewerEditPanel" class="image-viewer-edit-panel hidden">
          <input type="text" id="imageViewerEditInput" class="image-viewer-edit-input" placeholder="Edit prompt..." aria-label="Edit prompt" />
          <button id="imageViewerEditSubmit" class="image-viewer-edit-submit">Regenerate</button>
        </div>
      </div>
    </div>

    <!-- Confirm Modal -->
    <div id="customModal" class="modal-overlay hidden" role="dialog" aria-label="Confirmation">
      <div class="modal">
        <h3 id="modalTitle">Confirmation</h3>
        <p id="modalMessage">Are you sure you want to proceed?</p>
        <div class="modal-actions">
          <button id="modalCancel" class="btn-secondary">Cancel</button>
          <button id="modalConfirm" class="btn-primary">Confirm</button>
        </div>
      </div>
    </div>

    <!-- Auth Modal -->
    <div id="authModal" class="modal-overlay hidden" role="dialog" aria-label="Authentication">
      <div class="modal auth-modal">
        <button id="authClose" class="auth-close-btn" title="Close" aria-label="Close">&times;</button>
        <h3 id="authTitle">Welcome back</h3>
        <p class="auth-subtitle">Log in to save your chats across devices.</p>

        <div class="auth-tabs">
          <button type="button" class="auth-tab active" data-mode="login">Log in</button>
          <button type="button" class="auth-tab" data-mode="register">Sign up</button>
        </div>

        <form id="authForm" class="auth-form" autocomplete="off">
          <div id="authNameRow" class="auth-field hidden">
            <label for="authName">Name</label>
            <input type="text" id="authName" placeholder="Your name" />
          </div>
          <div class="auth-field">
            <label for="authEmail">Email</label>
            <input type="email" id="authEmail" placeholder="you@example.com" required />
          </div>
          <div class="auth-field">
            <label for="authPassword">Password</label>
            <input type="password" id="authPassword" placeholder="At least 6 characters" required />
          </div>
          <p id="authError" class="auth-error hidden"></p>
          <button type="submit" id="authSubmit" class="btn-primary auth-submit">Log in</button>
        </form>

        <% if (googleClientId) { %>
        <div id="authGoogleWrap" class="auth-google-wrap">
          <div class="auth-divider"><span>or</span></div>
          <div id="googleBtn"></div>
        </div>
        <% } %>
      </div>
    </div>

    <div id="searchOverlay" class="search-overlay hidden" role="dialog" aria-modal="true" aria-label="Search chats">
      <div id="searchPanel" class="search-panel">
        <div class="search-panel-head">
          <svg class="search-panel-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <circle cx="11" cy="11" r="7"></circle>
            <line x1="16.5" y1="16.5" x2="21" y2="21"></line>
          </svg>
          <input
            id="searchModalInput"
            type="text"
            class="search-panel-input"
            placeholder="Search chats..."
            autocomplete="off"
            spellcheck="false"
            role="combobox"
            aria-expanded="true"
            aria-controls="searchModalResults"
            aria-label="Search chats"
          />
          <button id="searchModalClose" class="search-panel-close" type="button" aria-label="Close search" title="Close search">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <line x1="6" y1="6" x2="18" y2="18"></line>
              <line x1="18" y1="6" x2="6" y2="18"></line>
            </svg>
          </button>
        </div>
        <div id="searchModalResults" class="search-panel-results" role="listbox" aria-label="Search results"></div>
        <div id="searchModalHint" class="search-panel-hint"></div>
      </div>
    </div>

    <div id="toastContainer" class="toast-container"></div>
    <toast-container></toast-container>
    <settings-modal></settings-modal>
    <share-modal></share-modal>

    <script>
      window.__INITIAL_MESSAGES__ = <%- initialMessages %>;
      window.__GOOGLE_CLIENT_ID__ = "<%= googleClientId %>";
    </script>
    <% if (googleClientId) { %>
    <script src="https://accounts.google.com/gsi/client" async defer></script>
    <% } %>
    <script type="module" src="/js/app.js"></script>
    <script type="module" src="/js/pages/chat.js"></script>
  </body>
</html>
