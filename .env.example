# ---- Core ----
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
MAX_MESSAGE_LENGTH=50000
MAX_HISTORY_LENGTH=20
MAX_BODY_SIZE=4mb

# ---- Model provider (at least one required) ----
ZENMUX_API_KEY=your_zenmux_api_key
# ZENMUX_MODEL=atria-asi/atria-dawn
OPENCODE_API_KEY=your_opencode_api_key
# OPENAI_API_KEY=your_openai_api_key
# OPENAI_MODEL=gpt-4o
# ANTHROPIC_API_KEY=your_anthropic_api_key
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODEL=gemini-2.0-flash

# ---- Web Search (optional) ----
# BRAVE_API_KEY=your_brave_search_api_key

# ---- Auth / Accounts (optional: without these the app runs in guest-only mode) ----
# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/qdevai?retryWrites=true&w=majority
# Secret used to sign login JWTs (use a long random string, min 16 chars)
JWT_SECRET=change-me-to-a-long-random-string
# Google OAuth Client ID (from Google Cloud Console -> Credentials -> OAuth client, type: Web)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# ---- Cloudinary (optional: for storing uploaded/generated images) ----
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
